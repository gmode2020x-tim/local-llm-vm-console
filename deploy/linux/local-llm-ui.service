[Unit]
Description=Local LLM UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/local-llm-vm-console
EnvironmentFile=-/opt/local-llm-vm-console/.env
ExecStart=/bin/bash -lc 'exec /opt/local-llm-vm-console/.venv/bin/gunicorn -w ${LLM_UI_WORKERS:-2} -b 0.0.0.0:${PORT:-8068} app.app:app'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
