APP_VERSION=0.1.0
PORT=8068

# VM-side UI settings
LLM_UI_DATA_DIR=/data
LLM_UI_DEFAULT_MODEL=llama3.2:3b
LLM_UI_TIMEOUT=300
LLM_UI_MODEL_LIST_TIMEOUT=3
LLM_UI_MAX_CHAT_CHARS=48000
LLM_UI_ALLOW_SHELL_JOBS=0

# If Ollama runs in the same Docker Compose project, use http://ollama:11434.
# If Ollama runs on the Windows host and the UI runs in a VM, use the host IP
# reachable from the VM, for example http://192.168.56.1:11434.
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_BASE_URL=http://ollama:11434/v1

# Optional host worker status endpoint.
HOST_WORKER_STATUS_URL=http://host.docker.internal:8090/gpu/status

# Host worker settings
HOST_WORKER_BIND=0.0.0.0
HOST_WORKER_PORT=8090
